<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-check of the Unity-only code paths against stubbed Unity APIs.

    Nothing here ships. Its whole purpose is that `#if UNITY_2021_3_OR_NEWER` code - which the ordinary
    build compiles away to nothing - still gets type-checked on a machine with no editor, so a typo in
    the UnityWebRequest transport is caught by CI rather than by the first person to open the package
    in Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Starhermit.UnityCompile</AssemblyName>
    <RootNamespace>Starhermit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_2021_3_OR_NEWER</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="stubs/UnityEngineStubs.cs" />
    <Compile Include="../../Packages/com.starhermit.sdk/Runtime/**/*.cs" />
    <Compile Include="../../Packages/com.starhermit.sdk/Samples~/**/*.cs" />
  </ItemGroup>

</Project>
